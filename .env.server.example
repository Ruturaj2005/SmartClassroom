# Secrets for docker-compose.yml. Copy to .env (never commit .env).

# Database password (any long random string)
POSTGRES_PASSWORD=change-me-to-a-long-random-password

# Signs login and card-tap tokens (any long random string)
JWT_SECRET=change-me-to-another-long-random-string

# Port the web UI and API are served on
HTTP_PORT=80

# How long a card tap stays logged in on a classroom Pi
EDGE_TAP_TOKEN_EXPIRES_IN=3h
