generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String     @id @default(cuid())
  email             String     @unique
  passwordHash      String
  role              UserRole   @default(FACULTY)
  isActive          Boolean    @default(true)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  faculty           Faculty?
  uploadedMaterials Material[] @relation("UploadedBy")

  @@index([email])
  @@map("users")
}

model Faculty {
  id                String             @id @default(cuid())
  userId            String             @unique
  employeeId        String             @unique
  name              String
  department        String
  designation       String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  courseAssignments CourseAssignment[]
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions          LectureSession[]
  rfidCards         RFIDCard[]
  timetableSlots    TimetableSlot[]

  @@index([employeeId])
  @@index([userId])
  @@map("faculty")
}

model RFIDCard {
  id           String     @id @default(cuid())
  uid          String     @unique
  facultyId    String
  status       RFIDStatus @default(ACTIVE)
  registeredAt DateTime   @default(now())
  lastUsedAt   DateTime?
  faculty      Faculty    @relation(fields: [facultyId], references: [id], onDelete: Cascade)

  @@index([uid])
  @@index([facultyId])
  @@map("rfid_cards")
}

model Course {
  id             String             @id @default(cuid())
  courseCode     String             @unique
  courseName     String
  description    String?
  department     String
  isActive       Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  assignments    CourseAssignment[]
  sessions       LectureSession[]
  materials      Material[]
  timetableSlots TimetableSlot[]

  @@index([courseCode])
  @@map("courses")
}

model CourseAssignment {
  id           String   @id @default(cuid())
  facultyId    String
  courseId     String
  academicYear String
  semester     String
  createdAt    DateTime @default(now())
  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  faculty      Faculty  @relation(fields: [facultyId], references: [id], onDelete: Cascade)

  @@unique([facultyId, courseId, academicYear, semester])
  @@index([facultyId])
  @@index([courseId])
  @@map("course_assignments")
}

model Classroom {
  id             String           @id @default(cuid())
  name           String
  building       String
  floor          String
  roomNumber     String
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  edgeDevice     EdgeDevice?
  sessions       LectureSession[]
  timetableSlots TimetableSlot[]

  @@map("classrooms")
}

model EdgeDevice {
  id              String           @id @default(cuid())
  deviceCode      String           @unique
  classroomId     String           @unique
  status          DeviceStatus     @default(OFFLINE)
  lastSeenAt      DateTime?
  lastSyncAt      DateTime?
  softwareVersion String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  cacheEntries    EdgeCacheEntry[]
  classroom       Classroom        @relation(fields: [classroomId], references: [id])

  @@index([deviceCode])
  @@map("edge_devices")
}

model TimetableSlot {
  id           String    @id @default(cuid())
  courseId     String
  facultyId    String
  classroomId  String
  dayOfWeek    DayOfWeek
  startTime    String
  endTime      String
  academicYear String
  semester     String
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  classroom    Classroom @relation(fields: [classroomId], references: [id])
  course       Course    @relation(fields: [courseId], references: [id])
  faculty      Faculty   @relation(fields: [facultyId], references: [id])

  @@index([dayOfWeek])
  @@index([classroomId])
  @@index([facultyId])
  @@index([courseId])
  @@map("timetable_slots")
}

model Material {
  id               String           @id @default(cuid())
  courseId         String
  title            String
  description      String?
  originalFileName String
  storedFileName   String
  relativePath     String
  mimeType         String
  fileSize         Int
  version          Int              @default(1)
  fileHash         String
  uploadedById     String
  isActive         Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  cacheEntries     EdgeCacheEntry[]
  sessions         LectureSession[]
  course           Course           @relation(fields: [courseId], references: [id])
  uploadedBy       User             @relation("UploadedBy", fields: [uploadedById], references: [id])

  @@index([courseId])
  @@index([uploadedById])
  @@map("materials")
}

model LectureSession {
  id            String        @id @default(cuid())
  facultyId     String
  courseId      String
  classroomId   String
  materialId    String?
  startedAt     DateTime      @default(now())
  endedAt       DateTime?
  retrievalMode RetrievalMode @default(SERVER)
  status        SessionStatus @default(STARTED)
  createdAt     DateTime      @default(now())
  classroom     Classroom     @relation(fields: [classroomId], references: [id])
  course        Course        @relation(fields: [courseId], references: [id])
  faculty       Faculty       @relation(fields: [facultyId], references: [id])
  material      Material?     @relation(fields: [materialId], references: [id])

  @@index([facultyId])
  @@index([courseId])
  @@index([classroomId])
  @@map("lecture_sessions")
}

model EdgeCacheEntry {
  id              String      @id @default(cuid())
  edgeDeviceId    String
  materialId      String
  materialVersion Int
  fileHash        String
  cachedAt        DateTime    @default(now())
  lastAccessedAt  DateTime?
  expiresAt       DateTime?
  status          CacheStatus @default(CACHED)
  edgeDevice      EdgeDevice  @relation(fields: [edgeDeviceId], references: [id], onDelete: Cascade)
  material        Material    @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([edgeDeviceId, materialId])
  @@index([edgeDeviceId])
  @@index([materialId])
  @@map("edge_cache_entries")
}

enum UserRole {
  ADMIN
  FACULTY
}

enum RFIDStatus {
  ACTIVE
  INACTIVE
  LOST
}

enum DeviceStatus {
  ONLINE
  OFFLINE
  MAINTENANCE
}

enum CacheStatus {
  CACHED
  EXPIRED
  INVALID
}

enum RetrievalMode {
  CACHE
  SERVER
  OFFLINE
}

enum SessionStatus {
  STARTED
  COMPLETED
  FAILED
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}
