// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  ADMIN
  FACULTY
}

enum RFIDStatus {
  ACTIVE
  INACTIVE
  LOST
}

enum DeviceStatus {
  ONLINE
  OFFLINE
  MAINTENANCE
}

enum CacheStatus {
  CACHED
  EXPIRED
  INVALID
}

enum RetrievalMode {
  CACHE
  SERVER
  OFFLINE
}

enum SessionStatus {
  STARTED
  COMPLETED
  FAILED
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

// ============================================================
// USER
// ============================================================

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  role         UserRole  @default(FACULTY)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  faculty      Faculty?
  uploadedMaterials Material[] @relation("UploadedBy")

  @@index([email])
  @@map("users")
}

// ============================================================
// FACULTY
// ============================================================

model Faculty {
  id          String   @id @default(cuid())
  userId      String   @unique
  employeeId  String   @unique
  name        String
  department  String
  designation String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  rfidCards       RFIDCard[]
  courseAssignments CourseAssignment[]
  timetableSlots  TimetableSlot[]
  sessions        LectureSession[]

  @@index([employeeId])
  @@index([userId])
  @@map("faculty")
}

// ============================================================
// RFID CARD
// ============================================================

model RFIDCard {
  id           String     @id @default(cuid())
  uid          String     @unique
  facultyId    String
  status       RFIDStatus @default(ACTIVE)
  registeredAt DateTime   @default(now())
  lastUsedAt   DateTime?

  faculty Faculty @relation(fields: [facultyId], references: [id], onDelete: Cascade)

  @@index([uid])
  @@index([facultyId])
  @@map("rfid_cards")
}

// ============================================================
// COURSE
// ============================================================

model Course {
  id          String   @id @default(cuid())
  courseCode  String   @unique
  courseName  String
  description String?
  department  String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignments    CourseAssignment[]
  timetableSlots TimetableSlot[]
  materials      Material[]
  sessions       LectureSession[]

  @@index([courseCode])
  @@map("courses")
}

// ============================================================
// COURSE ASSIGNMENT
// ============================================================

model CourseAssignment {
  id           String @id @default(cuid())
  facultyId    String
  courseId     String
  academicYear String
  semester     String
  createdAt    DateTime @default(now())

  faculty Faculty @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([facultyId, courseId, academicYear, semester])
  @@index([facultyId])
  @@index([courseId])
  @@map("course_assignments")
}

// ============================================================
// CLASSROOM
// ============================================================

model Classroom {
  id         String   @id @default(cuid())
  name       String
  building   String
  floor      String
  roomNumber String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  edgeDevice     EdgeDevice?
  timetableSlots TimetableSlot[]
  sessions       LectureSession[]

  @@map("classrooms")
}

// ============================================================
// EDGE DEVICE
// ============================================================

model EdgeDevice {
  id              String       @id @default(cuid())
  deviceCode      String       @unique
  classroomId     String       @unique
  status          DeviceStatus @default(OFFLINE)
  lastSeenAt      DateTime?
  lastSyncAt      DateTime?
  softwareVersion String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  classroom   Classroom        @relation(fields: [classroomId], references: [id])
  cacheEntries EdgeCacheEntry[]

  @@index([deviceCode])
  @@map("edge_devices")
}

// ============================================================
// TIMETABLE SLOT
// ============================================================

model TimetableSlot {
  id           String    @id @default(cuid())
  courseId     String
  facultyId    String
  classroomId  String
  dayOfWeek    DayOfWeek
  startTime    String    // HH:MM format (24h)
  endTime      String    // HH:MM format (24h)
  academicYear String
  semester     String
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  course    Course    @relation(fields: [courseId], references: [id])
  faculty   Faculty   @relation(fields: [facultyId], references: [id])
  classroom Classroom @relation(fields: [classroomId], references: [id])

  @@index([dayOfWeek])
  @@index([classroomId])
  @@index([facultyId])
  @@index([courseId])
  @@map("timetable_slots")
}

// ============================================================
// MATERIAL
// ============================================================

model Material {
  id               String   @id @default(cuid())
  courseId         String
  title            String
  description      String?
  originalFileName String
  storedFileName   String
  relativePath     String
  fileUrl          String?
  storageProvider  String   @default("local")
  mimeType         String
  fileSize         Int
  version          Int      @default(1)
  fileHash         String
  uploadedById     String
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  course      Course         @relation(fields: [courseId], references: [id])
  uploadedBy  User           @relation("UploadedBy", fields: [uploadedById], references: [id])
  sessions    LectureSession[]
  cacheEntries EdgeCacheEntry[]

  @@index([courseId])
  @@index([uploadedById])
  @@map("materials")
}

// ============================================================
// LECTURE SESSION
// ============================================================

model LectureSession {
  id            String        @id @default(cuid())
  facultyId     String
  courseId      String
  classroomId   String
  materialId    String?
  startedAt     DateTime      @default(now())
  endedAt       DateTime?
  retrievalMode RetrievalMode @default(SERVER)
  status        SessionStatus @default(STARTED)
  createdAt     DateTime      @default(now())

  faculty   Faculty   @relation(fields: [facultyId], references: [id])
  course    Course    @relation(fields: [courseId], references: [id])
  classroom Classroom @relation(fields: [classroomId], references: [id])
  material  Material? @relation(fields: [materialId], references: [id])

  @@index([facultyId])
  @@index([courseId])
  @@index([classroomId])
  @@map("lecture_sessions")
}

// ============================================================
// EDGE CACHE ENTRY
// ============================================================

model EdgeCacheEntry {
  id              String      @id @default(cuid())
  edgeDeviceId    String
  materialId      String
  materialVersion Int
  fileHash        String
  cachedAt        DateTime    @default(now())
  lastAccessedAt  DateTime?
  expiresAt       DateTime?
  status          CacheStatus @default(CACHED)

  edgeDevice EdgeDevice @relation(fields: [edgeDeviceId], references: [id], onDelete: Cascade)
  material   Material   @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([edgeDeviceId, materialId])
  @@index([edgeDeviceId])
  @@index([materialId])
  @@map("edge_cache_entries")
}
