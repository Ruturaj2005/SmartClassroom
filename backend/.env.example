# ============================================================
# SmartClass Backend — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── Server ──────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── Database ─────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/smartclass?schema=public"

# ── JWT ──────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=24h

# ── CORS ─────────────────────────────────────────────────────
# Allowed frontend origin (or comma-separated list for multiple origins)
FRONTEND_URL=https://smartclassroompccoe.netlify.app,http://localhost:5173

# ── File Storage ─────────────────────────────────────────────
# Relative path from backend root where uploads will be stored
UPLOAD_DIR=uploads

# Maximum file size in bytes (default: 50MB)
MAX_FILE_SIZE=52428800

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=info
